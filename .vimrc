" =========================================================
" 基本設定 (Basic Settings)
" =========================================================
set encoding=utf-8      " 文字コードをUTF-8に設定
set fileencodings=utf-8,cp932,euc-jp,sjis " 読み込み時の文字コード推測順
set number              " 行番号を表示する
set title               " ターミナルのウィンドウタイトルにファイル名を表示
set showcmd             " 入力中のコマンドを画面下部に表示する
set showmode            " 現在のモード（INSERT, VISUALなど）を表示する

" =========================================================
" 検索設定 (Search Settings)
" =========================================================
set hlsearch            " 検索結果をハイライト表示する
set incsearch           " 1文字入力するごとに検索を行う（インクリメンタルサーチ）
set ignorecase          " 検索時に大文字と小文字を区別しない
set smartcase           " 検索語に大文字が含まれている場合は区別する
set wrapscan            " ファイルの最後まで検索したら先頭に戻る

" =========================================================
" インデント・タブ設定 (Indent & Tab Settings)
" =========================================================
set expandtab           " タブキーを押した際にタブ文字ではなく空白を入力する
set tabstop=4           " タブ文字の表示幅を空白4つ分にする
set shiftwidth=4        " オートインデント時の空白の数を4つにする
set autoindent          " 改行時に前の行のインデントを自動で引き継ぐ
set smartindent         " 波括弧 { } などを認識して賢く自動インデントする

" =========================================================
" UI・見た目の設定 (UI & Appearance)
" =========================================================
syntax on               " コードの構文（シンタックス）ハイライトを有効にする
set cursorline          " カーソルがある行の背景色を少し変えて強調する
set showmatch           " 括弧を入力した際に対応する括弧を一瞬ハイライトする
set matchtime=1         " 対応する括弧をハイライトする時間を短く（0.1秒）する
set wildmenu            " コマンドラインの補完候補をメニュー一覧で表示する
set list                " 不可視文字（タブや行末の空白など）を表示する
set listchars=tab:»-,trail:- " 不可視文字の表示形式を指定

" =========================================================
" その他・便利設定 (Misc Settings)
" =========================================================
set clipboard=unnamedplus " OSのクリップボードとVimのコピー/ペーストを共有する
set backspace=indent,eol,start " バックスペースキーでインデントや改行を削除できるようにする
set nobackup            " バックアップファイル（~付きファイル）を作成しない
set noswapfile          " スワップファイル（.swp）を作成しない
set autoread            " 外部でファイルが変更されたら自動的に読み直す
